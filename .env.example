# SAEConnect (SAE Placement Hub) - Supabase Configuration
# Replace with your actual Supabase project URL and public API key
# Found in Supabase Dashboard -> Project Settings -> API Keys
#
# The browser-safe key is the "publishable" key (starts with sb_publishable_).
# Legacy projects may still list it as the "anon" key — both names are read.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
